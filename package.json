{
  "name": "uncc-six-mans",
  "version": "1.0.0",
  "main": "build/src/index.js",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs build",
    "lint": "eslint \"src/**/*.ts\"",
    "build:js": "tsc",
    "build": "npm run clean && npm run build:js",
    "bundle:sea": "node scripts/bundle-sea.mjs",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "package:windows": "npm run generate && npm run build && npm run bundle:sea && node scripts/package-windows-sea.mjs",
    "start": "tsx watch src/index.ts",
    "test": "jest --runInBand --testMatch='**/__tests__/*.unit.spec.ts' --testNamePattern=",
    "test:parallel": "jest --testMatch='**/__tests__/*.unit.spec.ts' --testNamePattern=",
    "integration": "node scripts/run-integration-tests.mjs",
    "integration:db:push": "node scripts/push-integration-schema.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N0ise9/UNCC-Six-Mans.js.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/N0ise9/UNCC-Six-Mans.js/issues"
  },
  "homepage": "https://github.com/N0ise9/UNCC-Six-Mans.js/#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/faker": "5.5.8",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "esbuild": "^0.25.4",
    "eslint": "^10.1.0",
    "faker": "5.5.3",
    "jest": "^30.3.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.8.1",
    "prisma": "^7.6.0",
    "rcedit": "^5.0.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "discord.js": "^14.26.2",
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^4.5.6",
    "luxon": "^3.7.2",
    "openai": "^6.33.0",
    "pg": "^8.20.0"
  }
}
