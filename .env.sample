# Discord bot token
token=

# OpenAI API key
openai=

# Used to encrypt the per-guild database URLs stored in .guild-instance-config.json
CONFIG_ENCRYPTION_KEY=

# Optional: override where Norm reads and writes runtime files.
# If unset, source mode uses the current working directory and the packaged EXE uses its own folder.
NORM_HOME=

# Optional runtime mode. Use "dev" for local development helpers.
ENVIRONMENT=dev

# Optional: password required by /prisma in addition to the Bot Admin role.
# This lives only on the host machine and is sent to the bot through Discord's normal TLS transport.
PRISMA_STUDIO_PASSWORD=

# Optional: rotate the per-guild OpenAI conversation after the input token count reaches this value.
conversation_token_limit=

# Optional: globally register /sora. When enabled, Norm uses the fixed model
# sora-2-2025-12-08 and each guild must still enable Sora in /setup set.
ENABLE_SORA=false

# Guild-specific queue/leaderboard/chat/API-status channels and Docker-exposed
# Postgres database URLs are configured per server through /setup set.
